flowchart TD
    A["workflows/monitoring/intraday.py 配置 / .env"] --> B["build_settings"]
    B --> C["基础 StrategyProfile"]
    C --> D["WatchCode / 买入 / 卖出 / 撤单独立覆盖"]
    D --> E{"启动前全量校验"}
    E -- 失败 --> F["失败关闭<br/>不创建行情或 Broker"]
    E -- 通过 --> G["不可变 StrategyRuntime"]

    G --> W["WatchlistStrategy"]
    W --> WC["生成当日 WatchCode"]
    WC --> RT["service.run_once"]

    G --> U["BuyStrategy"]
    G --> S["SellStrategy"]
    G --> X["CancelStrategy"]
    G --> L["ma5_dip_ladder 三档建仓 / 首次半仓止盈状态机"]
    RT --> CAND{"当前对象"}
    CAND -->|"WatchCode 内、无持仓"| U
    CAND -->|"活动三档持仓"| L
    CAND -->|"普通持仓 / 三档退出"| S
    U --> BR["Broker + 统一安全层"]
    L --> BR
    S --> BR
    BR --> P["自动订单 pending_orders.json<br/>后续轮次按 ID 对账 / 超时撤单"]
    P --> O["累计成交幂等入账、通知、复盘"]
    X --> M["手动 / 兼容同步订单"]
    M --> O
